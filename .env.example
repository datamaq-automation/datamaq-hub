# === BASE DE DATOS MySQL — Caché de APIs externas (schema datamaq_hub separado) ===
# Crear el schema en MySQL del VPS (una sola vez):
#   CREATE DATABASE IF NOT EXISTS datamaq_hub CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   GRANT ALL PRIVILEGES ON datamaq_hub.* TO 'datamaq'@'localhost'; FLUSH PRIVILEGES;
# Local (dejar vacío para deshabilitar caché y usar llamadas directas a la API):
DATABASE_URL=
# VPS DonWeb (producción):
# DATABASE_URL=mysql+pymysql://datamaq:PASSWORD@127.0.0.1:3306/datamaq_hub
