# === CREDENCIALES MCP / API GOOGLE ADS ===
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DAILY_BUDGET_LIMIT_ARS=1500

# === CREDENCIALES MCP / API GOOGLE BUSINESS PROFILE (ficha de Maps) ===
# CLIENT_ID y CLIENT_SECRET son opcionales: si se dejan vacíos se reutiliza el
# cliente OAuth de Google Ads. El REFRESH_TOKEN sí es propio, porque se emite
# por scope (https://www.googleapis.com/auth/business.manage).
#   python scripts/authenticate_gmail_oauth.py --scopes gbp --email <propietario>
# Requiere Basic API Access aprobado en el proyecto de GCP: sin aprobación la
# quota es 0 QPM y toda llamada devuelve 429.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
# Se resuelven con get_gbp_status() una vez autorizada la cuenta.
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# === CREDENCIALES MCP / API GOOGLE ANALYTICS 4 ===
# Ruta al JSON de la Cuenta de Servicio de GCP (Service Account).
# ⚠️ ESTA VARIABLE NO DEBE SINCRONIZARSE ENTRE ENTORNOS: es una ruta de
# filesystem, y copiarla tal cual del local al VPS deja apuntando a un archivo
# inexistente (GA4 responde `missing_credentials` en silencio, con HTTP 200).
# Local (ejemplo):
GOOGLE_APPLICATION_CREDENTIALS=/home/USUARIO/.config/gcp/datamaq-ga4-key.json
# VPS DonWeb (producción) — fuera del working tree, ver docs/credenciales_entornos.md:
# GOOGLE_APPLICATION_CREDENTIALS=/etc/datamaq-hub/ga4-key.json
GA4_PROPERTY_ID=

# === LLM APIs (DeepSeek) ===
DEEPSEEK_API_KEY=

# === CREDENCIALES MCP / API MICROSOFT CLARITY ===
CLARITY_ID=
CLARITY_API_TOKEN=

# === NOTIFICACIONES TELEGRAM (Watchdog & Alertas) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === BASE DE DATOS MySQL — Caché de APIs externas (schema datamaq_hub separado) ===
# Crear el schema en MySQL del VPS (una sola vez):
#   CREATE DATABASE IF NOT EXISTS datamaq_hub CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   GRANT ALL PRIVILEGES ON datamaq_hub.* TO 'datamaq'@'localhost'; FLUSH PRIVILEGES;
# Local (dejar vacío = fallback automático a SQLite file `data/datamaq_hub.db` con WAL):
DATABASE_URL=
# VPS DonWeb (producción):
# DATABASE_URL=mysql+pymysql://datamaq:PASSWORD@127.0.0.1:3306/datamaq_hub

# === TTLs de caché por prefijo (segundos) — opcional ===
# JSON. Vacío = el gateway usa sus defaults aprobados (Google Ads campaign 4h,
# search terms 12h, budget pacing 15min; GA4 1h; Clarity 2h).
# CACHE_TTLS={"google_ads:daily_budget_pacing": 900}

# === SERVIDOR DE CORREO IMAP (Lectura para OpenClaw — Cuenta Default / Clásica) ===
MAIL_IMAP_HOST=127.0.0.1
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=openclaw@datamaq.com.ar
MAIL_IMAP_PASS=
MAIL_IMAP_USE_SSL=true
MAIL_IMAP_TIMEOUT_SECONDS=10

# === SOPORTE MULTI-CUENTA DE CORREO (DataMaq, ABC Docente PBA, etc.) ===
# Permite definir múltiples buzones en formato JSON para consultarlos vía ?account={alias}
#
# Dos modos de autenticación por cuenta:
#   1) IMAP básica (password): cuenta con `password: "app_password_16_caracteres"`.
#   2) OAuth2 Gmail REST API (recomendada para Google Workspace): incluir
#      `oauth2_client_id`, `oauth2_client_secret` y `oauth2_refresh_token`.
#      Preferir este modo cuando exista el script de autorización interactiva
#      (`scripts/authenticate_gmail_oauth.py`), el cual genera el refresh_token offline.
#
# Ejemplo para buzón docente ABC (Google Workspace, IMAP básica):
# MAIL_ACCOUNTS={"abc": {"host": "imap.gmail.com", "port": 993, "user": "usuario@abc.gob.ar", "password": "app_password_16_caracteres", "use_ssl": true, "timeout_seconds": 10}}
#
# Ejemplo completo para buzón docente ABC vía OAuth2 (Gmail REST API):
# MAIL_ACCOUNTS={"abc": {"host": "imap.gmail.com", "port": 993, "user": "usuario@abc.gob.ar", "oauth2_client_id": "TU_CLIENT_ID.apps.googleusercontent.com", "oauth2_client_secret": "TU_CLIENT_SECRET", "oauth2_refresh_token": "1//TU_REFRESH_TOKEN_OFFLINE", "use_ssl": true, "timeout_seconds": 15}}
#
# Cuenta por defecto (sin parámetro ?account= en los endpoints de correo).
# Opción B: configurar DEFAULT_MAIL_ACCOUNT=abc para fijar ABC como buzón por defecto.
DEFAULT_MAIL_ACCOUNT=openclaw@datamaq.com.ar

# === BASE DE DATOS ROUNDCUBE (Contactos y Calendario) ===
# Local SQLite default:
ROUNDCUBE_DB_URL=sqlite:///data/roundcube.db
# VPS MySQL producción:
# ROUNDCUBE_DB_URL=mysql+pymysql://services:PASSWORD@127.0.0.1:3306/roundcube
